# ---------------------------------------------------------------------------
# Second Shot — biến môi trường
# Copy file này thành `.env` rồi điền giá trị thật. KHÔNG commit file `.env`.
# ---------------------------------------------------------------------------

# Bắt buộc ------------------------------------------------

# Chuỗi kết nối PostgreSQL (Neon hoặc PostgreSQL tương thích).
# Neon: Dashboard → Connection string → chọn "Prisma" hoặc "Node.js".
# Cần thêm `?sslmode=require` nếu nhà cung cấp yêu cầu.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Bí mật ký session Auth.js. Tạo bằng: npx auth secret
AUTH_SECRET="thay-bang-chuoi-ngau-nhien-toi-thieu-32-ky-tu"

# URL công khai của site (dùng cho canonical, sitemap, Open Graph).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Tài khoản admin tạo bởi seed (chỉ dùng cho môi trường dev/demo).
ADMIN_EMAIL="admin@secondshot.vn"
ADMIN_PASSWORD="Admin@12345"

# Tuỳ chọn: Cloudinary (chỉ khai báo khi thực sự dùng upload ảnh thật)
# Nếu để trống, admin vẫn nhập được URL ảnh thủ công (chế độ local).
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_API_KEY=""
# CLOUDINARY_API_SECRET=""
